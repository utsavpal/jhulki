# Supabase connection pooler URL (Project Settings > Database > Connection pooling).
# Use the pooler host on port 6543 with pgbouncer=true for serverless/Vercel deployments.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connect_timeout=30"

# Long, random secret used to sign and verify auth JWTs (e.g. `openssl rand -base64 48`).
JWT_SECRET="replace-with-a-long-random-secret"

# Brevo transactional API key
BREVO_API_KEY="xkeysib-..."

